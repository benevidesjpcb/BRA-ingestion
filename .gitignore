.Rhistory
.RData
.Ruserdata

.Rproj.user/

# Secrets — holds TATIC_TOKEN; must never be committed
.Renviron

data-raw/*
!data-raw/.gitkeep
# Track the analytic CSV outputs in data/, but not the large parquet extracts.
data/apdf/
data/asma/
outputs/*
!outputs/.gitkeep
temp/

# KPI08 (ODIN) downloads land in data-raw/kpi08/, already covered by data-raw/*.
# Keep this guard in case anything is written next to the script itself.
KPI08/*.json
KPI08/*.csv

# Dashboard data generated by KPI08/build_kpi08_dashboard.R. Deliberately NOT
# tracked: regenerating it inside the tracked page turned every rebuild into a
# merge conflict on one enormous line. Served over HTTP the page reads the
# analytic CSV in data/ live, so the published dashboard loses nothing.
kpi08-data.js